{
  "name": "urja-meter-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "test:live": "node scripts/live-check.js",
    "lint": "eslint .",
    "format": "prettier --write src test scripts openapi.json package.json README.md PROTOCOL.md",
    "format:check": "prettier --check src test scripts openapi.json package.json README.md PROTOCOL.md",
    "check:openapi": "node scripts/check-openapi.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "axios-cookiejar-support": "^7.0.0",
    "devalue": "^6.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
