# Optional service settings only. Copy to .env and change what you need.
# Do NOT put Urja email, password, or session tokens here — send those at login
# (or as SMOKE_EMAIL / SMOKE_PASSWORD when running npm run test:live).

HOST=127.0.0.1
PORT=3000
PORTAL_ORIGIN=https://urja-ops.flockenergy.tech
PORTAL_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
PORTAL_MAX_CONCURRENCY=4
PORTAL_MAX_QUEUE=20
LOG_LEVEL=info
